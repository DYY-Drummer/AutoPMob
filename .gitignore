.installed.cfg
*.egg

# 仮想環境
.venv/
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# 出力（必要に応じてコミットする場合はコメントアウト）
extracted_equations.json
extracted_equations_normalized.json
unified_equations.json
*.pdf
!docs/*.pdf

# 再生成可能な大容量グラフ（build_graph_data.py で再構築、GitHub 100MB 超）
*.pt
equation_graph.pt

# 生 PDF（研究データ、容量大・著作権物のためコミットしない）
input_pdfs/*
!input_pdfs/.gitkeep
pdfs/

# エディタ・スクリプトのバックアップ（データ *.bak.json は対象外）
*.py.bak
*.sh.bak

# Claude Code 内部状態（worktree 等）
.claude/

