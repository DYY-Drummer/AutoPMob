# API キー・秘密情報（絶対にコミットしない）
.env
.env.*
.env.local
*.pem
*_secret*

# Phase 5 sweep 個別ログ・中間 JSON（_summary.json はコミット可）
experiments/phase5_sweep/**/*.log
experiments/phase5_sweep/**/epochs=*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
